# Переменные, которые читают модули toolkit. У библиотеки своего env-файла нет: значения задаёт проект,
# который её использует, в своём /etc/<app>.env. Значения по умолчанию заданы в коде.

# --- src/ (TS-модули) ---
DATABASE_URL=              # db/migrate: строка Postgres; без неё migrate() падает с ошибкой, а не молчит
LLM_PROMPT_VERSION=        # llm: версия промпта в ключе кэша; по умолчанию — отпечаток системного промпта
INGEST_LOOKBACK_DAYS=      # ingest/freshness: окно свежести материала, дней
INGEST_STALE_FEED_DAYS=    # ingest/freshness: лента без новых записей дольше — «устаревшая»

# --- ops/monitoring (из /etc/monitoring.env и /etc/bds-telegram.env на хосте) ---
MONITORING_DB=             # БД с job_runs/job_schedule, по умолчанию stackradar
ALERT_REPEAT_HOURS=        # не повторять тревогу о той же задаче чаще, по умолчанию 6
TELEGRAM_BOT_TOKEN=        # бот тревог (в /etc/monitoring.env, 640 root:monitoring)
ALERT_CHAT_ID=             # чат тревог
ALERT_THREAD_ID=           # тема; по умолчанию BDS_TOPIC_LOGS
BDS_TOPIC_LOGS=            # тема «Логи» из /etc/bds-telegram.env
